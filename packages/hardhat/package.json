{
  "name": "@sh/hardhat",
  "version": "0.0.1",
  "scripts": {
    "account": "hardhat run scripts/listAccount.ts",
    "account:generate": "hardhat run scripts/generateAccount.ts",
    "account:import": "hardhat run scripts/importAccount.ts",
    "account:reveal-pk": "hardhat run scripts/revealPK.ts",
    "check-types": "tsc --noEmit --incremental",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "deploy": "hardhat run scripts/deployAll.ts",
    "flatten": "hardhat flatten",
    "format": "prettier --write './**/*.(ts|sol)'",
    "lint": "eslint",
    "lint-staged": "eslint",
    "test": "hardhat test",
    "hedera:compile": "hardhat compile",
    "hedera:test": "hardhat test test/hedera/DcaOrchestrator.ts test/hedera/AxelarMessageSender.ts",
    "hedera:deploy": "hardhat run scripts/hedera/deploy.ts --network hederaTestnet",
    "hedera:wire": "hardhat run scripts/hedera/wire.ts --network hederaTestnet",
    "hedera:fund": "hardhat run scripts/hedera/fundOrchestrator.ts --network hederaTestnet",
    "hedera:plan:create": "hardhat run scripts/hedera/createPlan.ts --network hederaTestnet",
    "hedera:plan:cancel": "hardhat run scripts/hedera/cancelPlan.ts --network hederaTestnet",
    "hedera:plan:reschedule": "hardhat run scripts/hedera/reschedulePlan.ts --network hederaTestnet",
    "hedera:plan:latest": "hardhat run scripts/hedera/latestPlan.ts --network hederaTestnet",
    "hedera:verify": "hardhat run scripts/hedera/verify.ts --network hederaTestnet",
    "hedera:withdraw:orchestrator": "hardhat run scripts/hedera/withdrawOrchestrator.ts --network hederaTestnet",
    "hedera:withdraw:sender": "hardhat run scripts/hedera/withdrawSender.ts --network hederaTestnet",
    "sepolia:compile": "hardhat compile",
    "sepolia:test": "hardhat test test/sepolia/DcaExecutor.ts",
    "sepolia:deploy": "hardhat run scripts/sepolia/deploy.ts --network ethereumSepolia",
    "sepolia:wire": "hardhat run scripts/sepolia/wire.ts --network ethereumSepolia",
    "sepolia:verify": "hardhat run scripts/sepolia/verify.ts --network ethereumSepolia",
    "sepolia:fund:usdc": "hardhat run scripts/sepolia/fundUsdc.ts --network ethereumSepolia",
    "sepolia:balance:check": "hardhat run scripts/sepolia/balanceCheck.ts --network ethereumSepolia",
    "sepolia:withdraw:executor": "hardhat run scripts/sepolia/withdrawExecutor.ts --network ethereumSepolia",
    "sepolia:withdraw:receiver": "hardhat run scripts/sepolia/withdrawReceiver.ts --network ethereumSepolia",
    "verify:contract": "ts-node scripts/verifySourcify.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "~2.0.7",
    "@nomicfoundation/hardhat-ethers": "~3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "~1.0.11",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "~0.5.1",
    "@typechain/hardhat": "~9.1.0",
    "@types/eslint": "~9.6.1",
    "@types/mocha": "~10.0.10",
    "@types/prettier": "~3.0.0",
    "@types/qrcode": "~1.5.5",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "chai": "~4.5.0",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "ethers": "^6.14.0",
    "hardhat": "2.22.19",
    "hardhat-gas-reporter": "~2.2.1",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "~1.4.1",
    "solidity-coverage": "~0.8.13",
    "ts-node": "~10.9.1",
    "typechain": "~8.3.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@axelar-network/axelar-gmp-sdk-solidity": "^6.1.0",
    "@inquirer/password": "^4.0.2",
    "@inquirer/select": "^4.0.2",
    "@openzeppelin/contracts": "5.6.1",
    "@typechain/ethers-v6": "~0.5.1",
    "dotenv": "~16.4.5",
    "envfile": "~7.1.0",
    "qrcode": "~1.5.4"
  }
}
